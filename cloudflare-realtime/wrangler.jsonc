{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-fighter-realtime",
	"main": "src/index.js",
	"compatibility_date": "2026-11-07",
	"workers_dev": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_ROOMS",
				"class_name": "GameRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GameRoom"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}